# WhatsApp is optional; these settings are not needed for Telegram.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Set an explicitly supported version from your Meta dashboard.
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE_NAME=train_vacancy_alert
WHATSAPP_TEMPLATE_LANGUAGE=en_US
