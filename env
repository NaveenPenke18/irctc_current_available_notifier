# Monitor settings (command-line flags override these; empty = built-in default)
# Route file path.
MONITOR_TRAINS=trains.json
# Comma-separated five-digit train numbers; empty scans all trains.
# MONITOR_TRAIN_NOS=12806
# State file path.
MONITOR_STATE=state.json
# Train start date YYYY-MM-DD; empty uses today's IST date.
# MONITOR_START_DATE=2026-10-20
# Seconds to wait between cycles; empty runs one cycle.
MONITOR_INTERVAL=1
# Chart API request timeout in seconds.
MONITOR_TIMEOUT=20
# Seconds between chart request starts.
MONITOR_REQUEST_DELAY=1
# true/false.
MONITOR_DEBUG=false
# console, telegram or whatsapp.
MONITOR_NOTIFICATION=telegram
MONITOR_KEEP_AWAKE=display
